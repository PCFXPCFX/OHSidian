{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "~/.ohos/config/your_debug.cer",
          "keyAlias": "debugKey",
          "keyPassword": "YOUR_KEY_PASSWORD",
          "profile": "~/.ohos/config/your_debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "~/.ohos/config/your_debug.p12",
          "storePassword": "YOUR_STORE_PASSWORD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // compatibleSdkVersion = HAP 能安装的最低系统版本,必须 <= 23:
        // DevEco 云测试只接受 compatibleSdkVersion 不超过 23 的应用。
        // 这里保持 6.0.2(22):闭源中间层(libelectron.so 等)按 API 22 验证,
        // 且 22 能覆盖 22/23 两代设备。版本对照:
        //   API 22 = "6.0.2(22)" / API 23 = "6.1.0(23)" /
        //   API 24 = "6.1.1(24)" / API 26 = "26.0.0(26)"
        // targetSdkVersion 只声明行为语义,可高于 compatibleSdkVersion。
        "compatibleSdkVersion": "6.0.2(22)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeLib": {
            "collectAllLibs": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "electron",
      "srcPath": "./electron",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    },
    {
      "name": "web_engine",
      "srcPath": "./web_engine"
    }
  ]
}
